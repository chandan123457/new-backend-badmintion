{
  "name": "shuttlepro-backend",
  "version": "1.0.0",
  "private": true,
  "main": "dist/server.js",
  "scripts": {
    "dev": "NODE_OPTIONS=--dns-result-order=ipv4first tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "NODE_OPTIONS=--dns-result-order=ipv4first node dist/server.js",
    "prisma:generate": "prisma generate",
    "prisma:push": "NODE_OPTIONS=--dns-result-order=ipv4first prisma db push",
    "seed": "NODE_OPTIONS=--dns-result-order=ipv4first tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.8.2",
    "cloudinary": "^2.10.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "qrcode": "^1.5.4",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.1",
    "@types/node": "^22.15.17",
    "@types/qrcode": "^1.5.6",
    "prisma": "^6.8.2",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
