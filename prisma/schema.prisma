generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum StudentStatus {
  ACTIVE
  INACTIVE
}

enum CourseType {
  COACHING
  MEMBERSHIP
}

enum PaymentStatus {
  PENDING
  PAID
}

model Course {
  id          String   @id @default(cuid())
  name        String
  courseType  CourseType @default(COACHING)
  coachName   String
  days        String
  startTime   String
  endTime     String
  duration    Int
  monthlyFee  Int
  maxCapacity Int
  enrolled    Int      @default(0)
  deletedAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  students    Student[]

  @@map("courses")
}

model Student {
  id                    String        @id @default(cuid())
  fullName              String
  // Optional: a student can be registered with just a phone number. NULL is
  // allowed many times over by the unique index, an empty string would not be.
  email                 String?       @unique
  phoneNumber           String
  address               String        @default("")
  photoUrl              String
  registeredAt          DateTime      @default(now())
  lastReactivatedAt     DateTime?
  courseEndAt           DateTime
  status                StudentStatus @default(ACTIVE)
  paymentStatus         PaymentStatus @default(PENDING)
  twoDaysReminderSentAt DateTime?
  oneDayReminderCount   Int           @default(0)
  finalDayReminderCount Int           @default(0)
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  courseId              String
  course                Course        @relation(fields: [courseId], references: [id], onDelete: Restrict)

  @@index([fullName])
  @@map("students")
}
